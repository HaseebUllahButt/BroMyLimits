# Runtime data — per-machine usage snapshots
claude-live-limits-*.json
grok-live-limits-*.json
usage-cache.json

# Limit-history ledger — a per-machine record of this user's own usage.
# Never committed: the live file is personal data and the backfill is derived
# from local transcripts and regenerates itself on startup.
limit-history.jsonl
limit-history-backfill.jsonl
limit-history-backfill.state.json

# Backups created by configure-statusline.js during install
*.cc-usage-backup

# Environment files
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor/IDE
.vscode/
.idea/
*.sublime-*

# Dependencies (if any project files are added later)
node_modules/
